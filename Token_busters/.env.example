# =========================================================
# Core App
# =========================================================
APP_ENV=local
APP_NAME=cx-agent
LOG_LEVEL=INFO
MASK_PII=true

# =========================================================
# LLM Provider - OpenRouter
# Required for LLM-powered summaries and recommendations
# =========================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_NAME=TokenBusters-CX-Agent
OPENROUTER_SITE_URL=http://localhost

# =========================================================
# Demo / Runtime Settings
# =========================================================
DEFAULT_ACTOR_ROLE=support_lead
DEFAULT_REGION=IN
DEFAULT_DATA_DIR=data
DEFAULT_OUTPUT_DIR=data/processed
ENABLE_LLM=true
ENABLE_SYNTHETIC_DATA=true

# =========================================================
# Security / Guardrails
# =========================================================
PII_SALT=
ENABLE_OWNERSHIP_GATE=true
ENABLE_CAPABILITY_GATE=true
REQUIRE_EVIDENCE_FOR_RECOMMENDATIONS=true

# =========================================================
# Evaluation
# =========================================================
ENABLE_EVAL_GATE=true
MIN_EVAL_PASS_RATE=0.80

# =========================================================
# Optional Storage
# Leave blank for the command-line MVP
# =========================================================
VECTOR_DB_PROVIDER=
VECTOR_DB_URL=
VECTOR_DB_API_KEY=

SQL_DATABASE_URL=

# =========================================================
# Optional Azure Expansion
# Not required for the initial command-line MVP
# =========================================================
AZURE_STORAGE_CONNECTION_STRING=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
AZURE_DATABRICKS_HOST=
AZURE_DATABRICKS_TOKEN=

