# =========================================================
# Core App
# =========================================================
APP_NAME=cx-agent
MASK_PII=true

# =========================================================
# LLM Provider - OpenRouter
# Required for LLM-powered summaries and recommendations
# =========================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_NAME=TokenBusters-CX-Agent
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_TIMEOUT_SECONDS=30

# =========================================================
# Demo / Runtime Settings
# =========================================================
DEFAULT_ACTOR_ROLE=support_lead
DEFAULT_REGION=IN
DEFAULT_DATA_DIR=data
DEFAULT_OUTPUT_DIR=data/processed
ENABLE_LLM=true

# =========================================================
# Security / Guardrails
# =========================================================
PII_SALT=
ENABLE_OWNERSHIP_GATE=true
ENABLE_CAPABILITY_GATE=true

# =========================================================
# Evaluation
# =========================================================
ENABLE_EVAL_GATE=true
MIN_EVAL_PASS_RATE=0.80
